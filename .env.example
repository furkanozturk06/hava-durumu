# Ortam değişkenleri örneği - bu dosyayı .env olarak kopyalayıp gerçek değerleri girin.
# .env dosyası .gitignore ile yok sayılır, asla commit'lemeyin.

# OpenWeatherMap API anahtarı (zorunlu). Tanımlı değilse backend başlamaz.
OPENWEATHER_API_KEY=YOUR_KEY_HERE

# CORS izin verilen originler (virgülle ayrılmış). Production'da gerçek domain'leri yazın.
CORS_ALLOWED_ORIGINS=http://localhost:5174
